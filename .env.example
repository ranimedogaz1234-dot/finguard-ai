# FinGuard AI configuration template. Copy values into user-secrets or environment variables.
# Never commit real secrets. ASP.NET Core maps "__" to ":" (e.g. Assistant__ApiKey -> Assistant:ApiKey).

ASPNETCORE_ENVIRONMENT=Development

# Database (SQLite file path, relative to src/FinGuard.Api)
ConnectionStrings__Default=Data Source=App_Data/finguard.db

# Demo data: seeds fictional suppliers/invoices/alerts into an EMPTY database at startup.
Demo__Seed=true
Demo__Password=<12+ character password for the fictional demo accounts>

# Authentication
Auth__AllowRegistration=true
# Only this email can become the first administrator on an empty system (unset = nobody self-registers as admin)
Auth__BootstrapAdminEmail=
Auth__AbsoluteSessionMinutes=720
Auth__PublicBaseUrl=http://localhost:5173

# Finance policy
Finance__ApprovalThreshold=10000
Finance__BaseCurrency=EUR

# AI assistant. Provider: None (labelled local demonstration mode) | Anthropic | OpenAI (any OpenAI-compatible endpoint)
Assistant__Provider=None
Assistant__ApiKey=<set via: dotnet user-secrets set "Assistant:ApiKey" "..." --project src/FinGuard.Api>
Assistant__Model=
Assistant__BaseUrl=

# CORS (only needed if the frontend is served from a different origin)
Cors__AllowedOrigins__0=http://localhost:5173

# Expose OpenAPI/Scalar outside Development (default: false)
OpenApi__Expose=false
