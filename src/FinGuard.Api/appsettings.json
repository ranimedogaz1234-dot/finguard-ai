{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" } },
  "AllowedHosts": "*",
  "ConnectionStrings": { "Default": "Data Source=App_Data/finguard.db" },
  "Auth": { "AllowRegistration": true, "MaxFailedLogins": 5, "LockoutMinutes": 15, "ResetTokenMinutes": 30, "PublicBaseUrl": "http://localhost:5173" },
  "Finance": { "ApprovalThreshold": 10000, "BaseCurrency": "EUR" },
  "Storage": { "UploadPath": "App_Data/uploads", "MaxPdfBytes": 5242880 },
  "Assistant": { "Provider": "None", "Model": null, "ApiKey": null, "BaseUrl": null, "MaxTokens": 900, "TimeoutSeconds": 30 },
  "Demo": { "Seed": false, "Password": null },
  "Cors": { "AllowedOrigins": [] },
  "RateLimits": { "AuthPerMinute": 10, "AssistantPerMinute": 20, "UploadsPerMinute": 20, "GlobalPerMinute": 600 }
}
